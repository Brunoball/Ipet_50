# Plantilla SIN credenciales. Copiar como backend/.env y completar solo localmente.
# Nunca subir backend/.env a Git.
APP_ENV=production
APP_TIMEZONE=America/Argentina/Cordoba

# La base existente de la web, que ya tiene analytics_counters (el contador solo usa esa tabla).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=web_ipet50
DB_USER=root
DB_PASSWORD=

# Mesas: el popup consulta el servicio externo; NO necesita otra base MySQL.
MESAS_API_URL=https://lerna.3devsnet.com/api/routes/api.php?action=form_obtener_config_inscripcion
MESAS_FORM_URL=https://inscripcion.ipet50.edu.ar/

# Bcrypt de la contraseña para aprobar recuerdos (en blanco deshabilita el panel).
# php -r 'echo password_hash("MI_CLAVE", PASSWORD_DEFAULT), PHP_EOL;'
RECUERDOS_ADMIN_PASSWORD_HASH=

# Localhost:3000 -> localhost:3001 está habilitado automáticamente solo en la PC local.
# Para otros orígenes de desarrollo, listarlos separados por comas.
# En producción dejar vacío, salvo un origen legítimo que necesites permitir.
CORS_ALLOWED_ORIGINS=
